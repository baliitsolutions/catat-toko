{
  "name": "pembuat-lisensi-catat-toko",
  "version": "1.0.0",
  "description": "Pembuat kode aktivasi Catat Toko (khusus penjual).",
  "author": "Bali IT Solutions",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "id.balitsolutions.catattoko.lisensi",
    "productName": "Pembuat Lisensi Catat Toko",
    "copyright": "Bali IT Solutions",
    "directories": { "output": "dist" },
    "files": ["main.js", "icon.png", "app/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png",
      "artifactName": "PembuatLisensi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pembuat Lisensi Catat Toko"
    }
  }
}
